# Storefront
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "local" allows catalog/bag previews. Payment stays closed until the durable
# order/reservation service and all payment credentials below are configured.
# Switch to "evershop" only after provisioning and validating its real checkout.
MANGATA_COMMERCE_MODE=local

# EverShop (server-side only)
EVERSHOP_BASE_URL=https://commerce.example.com
EVERSHOP_STOREFRONT_TOKEN=
# Own HTTPS handoff extension on the EVERSHOP_BASE_URL origin; not a stock checkout URL.
EVERSHOP_CHECKOUT_URL=
# Used only by `npm run evershop:import -- --commit`.
EVERSHOP_ADMIN_TOKEN=

# Optional local Mercado Pago checkout: ALL these private fields are required.
# See docs/COMMERCE-READINESS.md. The durable service is a pending integration,
# not a backend included in this repository. NEXT_PUBLIC_SITE_URL must use HTTPS.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# At least 32 randomly generated characters; signs the checkout session cookie.
COMMERCE_SESSION_SECRET=
# Private HTTPS service implementing atomic reservations and idempotent payment recording.
MANGATA_ORDER_SERVICE_URL=
MANGATA_ORDER_SERVICE_TOKEN=
